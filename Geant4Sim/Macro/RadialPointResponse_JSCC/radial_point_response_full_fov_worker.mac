# JSCC radial point-response study: all configurations
# One /run/beamOn per block. CSV row order follows radial_point_manifest.csv.
# Run this macro once in one clean directory; do not append a second run.
# Exactly one GPS source is reused and overwritten for every block.

# row 1: radial_r000_t000_E218 | factor=(0.0000, 0.0000, 0.0000) mm
/gps/particle gamma
/gps/number 1
/gps/energy 218 keV
/gps/pos/type Point
/gps/pos/centre 0.0000 -245.0000 0.0000 mm
/gps/ang/type iso
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 180 deg
/run/beamOn 1000000

# row 2: radial_r000_t000_E440 | factor=(0.0000, 0.0000, 0.0000) mm
/gps/particle gamma
